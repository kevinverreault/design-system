---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import dusk from '../assets/showcase/dusk.jpg';
import Gallery from '../components/media/Gallery.astro';
import Image from '../components/media/Image.astro';
import Lightbox from '../components/media/Lightbox.astro';

const galleryImages = [
  { src: dusk, alt: "Mountains at dusk", credit: "Kevin Verreault 2024" },
  { src: "/images/snow.jpg", alt: "Snowfield under a white sky", credit: "Kevin Verreault 2023", width: 1200, height: 800 }
];
---

<!doctype html>
<html lang="en" class="theme-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gallery under the ClientRouter</title>
    <ClientRouter />
  </head>
  <body>
    <main class="flow">
      <h1>Gallery under the ClientRouter</h1>

      <p>Astro's <code>ClientRouter</code> claims every same-origin link click. A Gallery image still opens in the Lightbox, and so does an image of a site gallery that uses the <code>gallery-open</code> contract. <a href="/">Back to the showcase</a>.</p>

      <Lightbox id="lightbox-routed" />

      <Gallery images={galleryImages} id="gallery-routed" aria-label="Paysages" />

      <ul data-gallery id="host-gallery-routed" class="host-gallery" role="list" aria-label="Paysages du site">
        <li>
          <a href="/images/snow.jpg" data-gallery-link data-caption="Fresh snow under a white winter sky." data-width="1200" data-height="800">
            <Image src="/images/snow.jpg" alt="A snowfield" width={1200} height={800} ratio="1:1" sizes="10rem" />
          </a>
        </li>
      </ul>
    </main>
  </body>
</html>

<script>
  import { handleGalleryClick } from '../components/media/gallery-open';

  // What a host site does for its own galleries, as gallery-open.ts documents it.
  document.addEventListener('click', handleGalleryClick, { capture: true });
</script>

<style>
  main {
    max-width: 60rem;
    margin: 0 auto;
    padding: var(--space-lg);
  }

  .host-gallery {
    display: flex;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .host-gallery a {
    display: block;
    width: 10rem;
  }
</style>
