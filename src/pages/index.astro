---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import Colors from '../components/demo/Colors.astro';
import Button from '../components/ui/Button.astro';
import NavigationBar from '../components/navigation/NavigationMenu.astro';
import { NavigationItems } from '../data/navigation';
import Icon from '../components/ui/Icon.astro';
import Accordion from '../components/navigation/Accordion.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro'
import Row from '../components/layout/Row.astro';
import Pane from '../components/layout/Pane.astro';
import Image from '../components/media/Image.astro';
import Link from '../components/ui/Link.astro';
import dusk from '../assets/showcase/dusk.jpg';

const buttonVariants = ["primary", "secondary", "muted", "danger"] as const;
const buttonTypes = ["outline", "ghost", "underline"] as const;
const buttonSizes = ["icon", "small", "medium", "large", "extra-large"] as const;
const buttonShapes = ["rectangle", "square", "circle", "rounded"] as const;
const rowBackgrounds = ["background", "surface", "primary", "secondary"] as const;
const rowGaps = ["small", "medium", "large"] as const;
const paneAlignments = ["start", "center", "end"] as const;
const imageRatios = ["1:1", "3:2", "16:9"] as const;

---

<Layout title="Design system">
  <div class="container flow" style="--flow-space: 2rem; margin-top: 2rem;">
    <div class="flex flex-row items-center justify-space-between">
      <h1>Design system</h1>

      <div>
        <ThemeToggle />
      </div>
    </div>
    
    <section id="colors" class="flow">
      <h2 class="numbered-title"><span>01</span> Colors</h2>
        
      <Colors />
    </section>

    <section id="typography" class="flow">
      <h2 class="numbered-title"><span>02 </span>Typography</h2>
      <div class="flex">
          <div class="flow typography-section">
              <div> 
                  <p>Heading 1 - Serif - 150px</p>
                  <p class="text-5xl ff-serif">Arthur</p>
              </div>
              <div> 
                  <p>Heading 2 - Serif - 100px</p>
                  <p class="text-4xl ff-serif">Kaamelott</p>
              </div>
              <div> 
                  <p>Heading 3 - Serif - 56px</p>
                  <p class="text-3xl ff-serif">Merlin & Élias</p>
              </div>
              <div> 
                  <p>Heading 4 - Serif - 32px</p>
                  <p class="text-2xl ff-serif">Perceval & Karadoc</p>
              </div>
              <div> 
                  <p>Heading 5 - 28px - 4.75 Character Space</p>
                  <p class="text-xl ff-sans-condensed letter-spacing-1">Yvain, chevalier au Lion ou l'orphelin de Carmélide</p>
              </div>       
          </div>
          
          <div class="flow typography-section">
              <div> 
                  <p>Subheading 1 - Serif - 28px</p>
                  <p class="text-lg ff-sans-normal">384,400 pintes de bière</p>
              </div>
              <div> 
                  <p>Subheading 2 - Condensed Sans-serif - 14px - 2.35 Character Space</p>
                  <p class="text-sm ff-sans-condensed letter-spacing-sm">Gauvain, chevalier au Pancréas</p>
              </div>
              <div> 
                  <p>Nav Text - Condensed Sans-serif - 16px - 2.7 Character Space</p>
                  <p class="text-md ff-sans-condensed letter-spacing-md">Kadoc</p>
              </div>
              <div> 
                  <p>Body Text</p>
                  <p>Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Phasellus hendrerit. Pellentesque aliquet nibh nec urna. In nisi neque, aliquet vel, dapibus id, mattis vel, nisi. Sed pretium, ligula sollicitudin laoreet viverra, tortor libero sodales leo, eget blandit nunc tortor eu nibh. Nullam mollis. Ut justo. Suspendisse potenti.Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Phasellus hendrerit. Pellentesque aliquet nibh nec urna. In nisi neque, aliquet vel, dapibus id, mattis vel, nisi. Sed pretium, ligula sollicitudin laoreet viverra, tortor libero sodales leo, eget blandit nunc tortor eu nibh. Nullam mollis. Ut justo. Suspendisse potenti.Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Phasellus hendrerit. Pellentesque aliquet nibh nec urna. In nisi neque, aliquet vel, dapibus id, mattis vel, nisi. </p>
              </div>
          </div>
      </div>
    </section>

    <section class="flow" id="interactive-elements">
      <h2 class="numbered-title"><span>03</span> Interactive elements</h2>

      <h3 class="numbered-title">Navigation</h3>
      
      <div style="padding-right: 18rem;">
        <nav>
          <NavigationBar navigationItems={NavigationItems} />
        </nav>
      </div>

      <h3 class="numbered-title">Accordion</h3>

      <div style="width:33%">
        <Accordion navigationItems={NavigationItems} />
      </div>

      <h3 class="numbered-title">Button</h3>
      
      <h4 class="numbered-title">Variants</h4>

      <div class="flex flex-column" style="width:60%">
        {
          buttonVariants.map(variant => (
            <div class="grid grid-auto-column">
              <div><Button variant={variant}>{variant}</Button></div>
              {buttonTypes.map(decoration => <div><Button variant={variant} decoration={decoration} textVariant={decoration === "ghost" ? "colored" : "default"}>{decoration}</Button></div>)}
            </div>
          ))
        }

      </div>

      <h4 class="numbered-title">Sizes</h4>

      <div class="flex flex-row">
        {
          buttonSizes.map(size => (
            <div>
              {
                size !== "icon" ? <Button size={size}>{size}</Button> :
                <Button size="icon" shape="circle" aria-label="instagram">
                  <Icon icon="instagram" width="1.5rem" height="1.5rem" color="inherit"/>
                </Button>
              }
            </div>
          ))
        }
      </div>

      <h4 class="numbered-title">Shapes</h4>

      <div class="flex flex-row items-center">
        {
          buttonShapes.map(shape => (
            <div><Button shape={shape}>{shape}</Button></div>
          ))
        }
      </div>
      
    </section>

    <section id="row" class="flow">
      <h2 class="numbered-title"><span>04</span> Row &amp; Pane</h2>

      <h3 class="numbered-title">Columns</h3>

      <Row>
        <Pane class="demo-pane">One column</Pane>
      </Row>

      <Row columns={2} id="row-two-columns">
        <Pane class="demo-pane">Two columns</Pane>
        <Pane class="demo-pane">1:1 by default</Pane>
      </Row>

      <Row columns={3} id="row-three-columns">
        <Pane class="demo-pane">Three</Pane>
        <Pane class="demo-pane">equal</Pane>
        <Pane class="demo-pane">columns</Pane>
      </Row>

      <h3 class="numbered-title">Ratio</h3>

      <Row columns={2} ratio="2:1">
        <Pane class="demo-pane">2:1 — the wide side</Pane>
        <Pane class="demo-pane">narrow side</Pane>
      </Row>

      <Row columns={2} ratio="1:2">
        <Pane class="demo-pane">1:2 — narrow side</Pane>
        <Pane class="demo-pane">the wide side</Pane>
      </Row>

      <h3 class="numbered-title">Gap</h3>

      {
        rowGaps.map(gap => (
          <Row columns={3} gap={gap}>
            <Pane class="demo-pane">gap</Pane>
            <Pane class="demo-pane">{gap}</Pane>
            <Pane class="demo-pane">gap</Pane>
          </Row>
        ))
      }

      <h3 class="numbered-title">Background</h3>

      {
        rowBackgrounds.map(background => (
          <Row columns={2} background={background} id={`row-${background}`} aria-label={`${background} background`}>
            <Pane>background="{background}"</Pane>
            <Pane align="end">Switches with the theme</Pane>
          </Row>
        ))
      }

      <h3 class="numbered-title">Width</h3>

      <Row columns={2} background="surface" width="full">
        <Pane>width="full"</Pane>
        <Pane align="end">Spans the whole parent</Pane>
      </Row>

      <Row columns={2} background="surface" width="contained">
        <Pane>width="contained"</Pane>
        <Pane align="end">Content stays within the site container</Pane>
      </Row>

      <h3 class="numbered-title">Pane alignment</h3>

      <Row columns={3}>
        {
          paneAlignments.map(align => (
            <Pane align={align} class="demo-pane demo-tall"><span>align="{align}"</span></Pane>
          ))
        }
      </Row>

      <Row columns={3}>
        {
          paneAlignments.map(valign => (
            <Pane valign={valign} class="demo-pane demo-tall"><span>valign="{valign}"</span></Pane>
          ))
        }
      </Row>

      <Row columns={2} ratio="2:1">
        <Pane>
          <Image src={dusk} alt="Mountains at dusk" ratio="3:2" />
        </Pane>
        <Pane center>
          <p>center</p>
          <p>Text sits in the middle of the taller image beside it, on both axes.</p>
        </Pane>
      </Row>

      <h3 class="numbered-title">Stacking</h3>

      <p>A Row stacks to one column when the Row itself is narrower than 40rem, whatever the viewport.</p>

      <div class="demo-narrow-container">
        <Row columns={3} id="row-in-narrow-container">
          <Pane class="demo-pane">Inside</Pane>
          <Pane class="demo-pane">a narrow</Pane>
          <Pane class="demo-pane">container</Pane>
        </Row>
      </div>
    </section>

    <section id="image" class="flow">
      <h2 class="numbered-title"><span>05</span> Image</h2>

      <h3 class="numbered-title">Sources and credit</h3>

      <Row columns={3}>
        <Pane id="image-local">
          <Image src={dusk} alt="Mountains at dusk, local asset" credit="Kevin Verreault 2024" />
        </Pane>
        <Pane id="image-remote">
          <Image src="/images/snow.jpg" alt="Snowfield, URL source" credit="Credit on a white photo" width={1200} height={800} />
        </Pane>
        <Pane>
          <Image src={dusk} alt="Mountains at dusk, no credit" />
        </Pane>
      </Row>

      <h3 class="numbered-title">Credit slot</h3>

      <Row columns={2}>
        <Pane>
          <Image src={dusk} alt="Mountains at dusk, custom credit" credit="Replaced by the slot">
            <Fragment slot="credit">© <a href="#image">Kevin Verreault</a> · Prints available</Fragment>
          </Image>
        </Pane>
      </Row>

      <h3 class="numbered-title">Ratio and fit</h3>

      <Row columns={3}>
        {
          imageRatios.map(ratio => (
            <Pane>
              <Image src={dusk} alt={`Mountains at dusk, ${ratio} cover`} ratio={ratio} credit={`ratio="${ratio}"`} />
            </Pane>
          ))
        }
      </Row>

      <Row columns={2}>
        <Pane>
          <Image src={dusk} alt="Mountains at dusk, square cover" ratio="1:1" fit="cover" credit='fit="cover"' />
        </Pane>
        <Pane>
          <Image src={dusk} alt="Mountains at dusk, square contain" ratio="1:1" fit="contain" credit='fit="contain"' class="demo-contain" />
        </Pane>
      </Row>
    </section>
  </div>
</Layout>

<style>

  section:last-child {
    margin-bottom: 50vh;
  }

  .numbered-title {
    font-family: var(--ff-sans-condensed);
    font-size: var(--fs-xl);
    text-transform: uppercase;
    letter-spacing: 4.72px; 
  }

  .numbered-title span {
      margin-right: .5em;
      font-weight: 700;
      color: hsl( var(--color-on-background) / .50);
  }

  .typography-section {
    flex-basis: 100%;
    --flow-space: 3rem;
    padding: 0 1rem;
  }

  .typography-section > div p:first-child {
    margin-bottom: 1rem;
  }

  .primary-navigation {
    --gap: 8rem;
    --underlined-gap: 2rem;
    list-style: none;
    padding: 0;
    margin: 0;

  }

  .primary-navigation a {
    text-decoration: none;
  }

  #interactive-elements > div {
    padding: 0 1rem;
  }

  #interactive-elements > h4 {
    margin-left: 1rem;
  }

  .demo-pane {
    padding: 1rem;
    border: 1px dashed hsl(var(--color-on-background) / .4);
  }

  .demo-tall {
    min-height: 10rem;
  }

  .demo-narrow-container {
    max-width: 30rem;
  }

  :global(.demo-contain) {
    background-color: hsl(var(--color-surface));
  }

</style>
