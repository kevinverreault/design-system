---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Colors from '../components/demo/Colors.astro';
import Button from '../components/ui/Button.astro';
import NavigationBar from '../components/navigation/NavigationMenu.astro';
import { NavigationItems } from '../data/navigation';
import Icon from '../components/ui/Icon.astro';
import Accordion from '../components/navigation/Accordion.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro'
import Label from '../components/form/Label.astro';
import Input from '../components/form/Input.astro';
import Textarea from '../components/form/Textarea.astro';
import Select from '../components/form/Select.astro';
import Checkbox from '../components/form/Checkbox.astro';
import RadioGroup from '../components/form/RadioGroup.astro';
import Switch from '../components/form/Switch.astro';
import FormField from '../components/form/FormField.astro';
import Row from '../components/layout/Row.astro';
import Pane from '../components/layout/Pane.astro';
import Image from '../components/media/Image.astro';
import dusk from '../assets/showcase/dusk.jpg';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import Avatar from '../components/ui/Avatar.astro';
import Separator from '../components/ui/Separator.astro';
import Table from '../components/ui/Table.astro';
import Skeleton from '../components/ui/Skeleton.astro';
import Gallery from '../components/media/Gallery.astro';
import Alert from '../components/feedback/Alert.astro';
import Tabs from '../components/navigation/Tabs.astro';
import TabPanel from '../components/navigation/TabPanel.astro';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import Pagination from '../components/navigation/Pagination.astro';
import Footer from '../components/navigation/Footer.astro';
import Dialog from '../components/overlay/Dialog.astro';
import AlertDialog from '../components/overlay/AlertDialog.astro';
import Sheet from '../components/overlay/Sheet.astro';
import { sheetSides, type SheetSide } from '../components/overlay/dialog-variants';
import Lightbox from '../components/media/Lightbox.astro';
import Popover from '../components/overlay/Popover.astro';
import DropdownMenu from '../components/overlay/DropdownMenu.astro';
import Tooltip from '../components/overlay/Tooltip.astro';

const buttonVariants = ["primary", "secondary", "muted", "danger"] as const;
const buttonTypes = ["outline", "ghost", "underline"] as const;
const buttonSizes = ["icon", "small", "medium", "large", "extra-large"] as const;
const buttonShapes = ["rectangle", "square", "circle", "rounded"] as const;
const controlSizes = ["small", "medium", "large"] as const;
const printFormats = [
  { value: "a4", label: "A4 — 21 × 30 cm" },
  { value: "a3", label: "A3 — 30 × 42 cm" },
  { value: "a2", label: "A2 — 42 × 59 cm", disabled: true }
];
const rowBackgrounds = ["background", "surface", "primary", "secondary"] as const;
const rowGaps = ["small", "medium", "large"] as const;
const paneAlignments = ["start", "center", "end"] as const;
const imageRatios = ["1:1", "3:2", "16:9"] as const;
const badgeVariants = ["primary", "secondary", "muted", "danger", "outline"] as const;
const avatarSizes = ["small", "medium", "large"] as const;
const printColumns = [
  { key: "size", label: "Size" },
  { key: "paper", label: "Paper" },
  { key: "edition", label: "Edition", align: "center" },
  { key: "price", label: "Price", align: "end" }
] as const;
const printRows = [
  { size: "20 × 30 cm", paper: "Matte", edition: "Open", price: "45 $" },
  { size: "30 × 45 cm", paper: "Lustre", edition: "Open", price: "75 $" },
  { size: "40 × 60 cm", paper: "Fine art", edition: "25", price: "120 $" },
  { size: "60 × 90 cm", paper: "Fine art", edition: "10", price: "240 $" }
];
const galleryImages = [
  { src: dusk, alt: "Mountains at dusk", credit: "Kevin Verreault 2024" },
  { src: "/images/snow.jpg", alt: "Snowfield under a white sky", credit: "Kevin Verreault 2023", width: 1200, height: 800 },
  { src: dusk, alt: "Ridge line at dusk" },
  { src: "/images/snow.jpg", alt: "Tracks in the snow", credit: "Kevin Verreault 2022", width: 1200, height: 800 },
  { src: dusk, alt: "Last light over the hills", credit: "Kevin Verreault 2024" },
  { src: "/images/snow.jpg", alt: "Fresh snow", width: 1200, height: 800 }
];
const duskFullSize = await getImage({ src: dusk, widths: [600, 900, 1200] });
// The Lightbox shows a photo at most the viewport width less its 2rem margins.
const responsiveDusk = { thumbnail: dusk, href: duskFullSize.src, srcset: duskFullSize.srcSet.attribute, sizes: "calc(100vw - 4rem)" };
const captionedPhotos: { thumbnail: typeof dusk | string, href: string, srcset?: string, sizes?: string, alt: string, caption?: string, credit?: string }[] = [
  { ...responsiveDusk, alt: "Hills under an orange sky", caption: "The last light over the hills, an hour after sunset.", credit: "Kevin Verreault 2024" },
  { thumbnail: "/images/snow.jpg", href: "/images/snow.jpg", alt: "A snowfield", caption: "Fresh snow under a white winter sky." },
  { ...responsiveDusk, alt: "A ridge line at dusk", credit: "Kevin Verreault 2023" }
];

const alerts = [
  { variant: "info", icon: "info", title: "Shipping", message: "Prints ship within five business days." },
  { variant: "success", icon: "circle-check", title: "Order received", message: "A confirmation email is on its way." },
  { variant: "warning", icon: "triangle-alert", title: "Limited edition", message: "Only three prints of this photo remain." },
  { variant: "danger", icon: "circle-alert", title: "Payment declined", message: "Check your card details and try again." }
] as const;
const breadcrumbItems = [
  { text: "Accueil", path: "/" },
  { text: "Portfolio", path: "#breadcrumbs" },
  { text: "Oiseaux", path: "#breadcrumbs" }
];
const paginationItems = [1, 2, 3, 4, 5].map(page => ({ text: String(page), path: `#pagination-page-${page}` }));
const footerGroups = NavigationItems
  .filter(item => item.subMenuLinks)
  .map(item => ({ title: item.text, links: item.subMenuLinks! }));
const sheetSideNames = Object.keys(sheetSides) as SheetSide[];
const dialogSizes = ["small", "medium", "large"] as const;
const printActions = [
  { text: "View the photo", path: "#dropdown-menu" },
  { text: "Add to cart", value: "add" },
  { text: "Add to wishlist", value: "wishlist" },
  { text: "Reserve a framed print", value: "reserve", disabled: true },
  { text: "Share", value: "share" }
];
const footerSocial = [
  { icon: "instagram", text: "Instagram", path: "#footer" },
  { icon: "facebook", text: "Facebook", path: "#footer" },
  { icon: "x-twitter", text: "X", path: "#footer" }
];

---

<Layout title="Design system">
  <div class="container flow" style="--flow-space: 2rem; margin-block: 2rem;">
    <div class="flex flex-row items-center justify-space-between">
      <h1>Design system</h1>

      <div>
        <ThemeToggle />
      </div>
    </div>
    
    <section id="colors" class="flow">
      <h2 class="numbered-title"><span>01</span> Colors</h2>
        
      <Colors />
    </section>

    <section id="typography" class="flow">
      <h2 class="numbered-title"><span>02 </span>Typography</h2>
      <div class="flex">
          <div class="flow typography-section">
              <div> 
                  <p>Heading 1 - Serif - 150px</p>
                  <p class="text-5xl ff-serif">Arthur</p>
              </div>
              <div> 
                  <p>Heading 2 - Serif - 100px</p>
                  <p class="text-4xl ff-serif">Kaamelott</p>
              </div>
              <div> 
                  <p>Heading 3 - Serif - 56px</p>
                  <p class="text-3xl ff-serif">Merlin & Élias</p>
              </div>
              <div> 
                  <p>Heading 4 - Serif - 32px</p>
                  <p class="text-2xl ff-serif">Perceval & Karadoc</p>
              </div>
              <div> 
                  <p>Heading 5 - 28px - 4.75 Character Space</p>
                  <p class="text-xl ff-sans-condensed letter-spacing-1">Yvain, chevalier au Lion ou l'orphelin de Carmélide</p>
              </div>       
          </div>
          
          <div class="flow typography-section">
              <div> 
                  <p>Subheading 1 - Serif - 28px</p>
                  <p class="text-lg ff-sans-normal">384,400 pintes de bière</p>
              </div>
              <div> 
                  <p>Subheading 2 - Condensed Sans-serif - 14px - 2.35 Character Space</p>
                  <p class="text-sm ff-sans-condensed letter-spacing-sm">Gauvain, chevalier au Pancréas</p>
              </div>
              <div> 
                  <p>Nav Text - Condensed Sans-serif - 16px - 2.7 Character Space</p>
                  <p class="text-md ff-sans-condensed letter-spacing-md">Kadoc</p>
              </div>
              <div> 
                  <p>Body Text</p>
                  <p>Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Phasellus hendrerit. Pellentesque aliquet nibh nec urna. In nisi neque, aliquet vel, dapibus id, mattis vel, nisi. Sed pretium, ligula sollicitudin laoreet viverra, tortor libero sodales leo, eget blandit nunc tortor eu nibh. Nullam mollis. Ut justo. Suspendisse potenti.Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Phasellus hendrerit. Pellentesque aliquet nibh nec urna. In nisi neque, aliquet vel, dapibus id, mattis vel, nisi. Sed pretium, ligula sollicitudin laoreet viverra, tortor libero sodales leo, eget blandit nunc tortor eu nibh. Nullam mollis. Ut justo. Suspendisse potenti.Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Phasellus hendrerit. Pellentesque aliquet nibh nec urna. In nisi neque, aliquet vel, dapibus id, mattis vel, nisi. </p>
              </div>
          </div>
      </div>
    </section>

    <section class="flow" id="interactive-elements">
      <h2 class="numbered-title"><span>03</span> Interactive elements</h2>

      <h3 class="numbered-title">Navigation</h3>
      
      <div style="padding-right: 18rem;">
        <nav>
          <NavigationBar navigationItems={NavigationItems} />
        </nav>
      </div>

      <h3 class="numbered-title">Accordion</h3>

      <div style="width:33%">
        <Accordion navigationItems={NavigationItems} />
      </div>

      <h3 class="numbered-title">Button</h3>
      
      <h4 class="numbered-title">Variants</h4>

      <div class="flex flex-column" style="width:60%">
        {
          buttonVariants.map(variant => (
            <div class="grid grid-auto-column">
              <div><Button variant={variant}>{variant}</Button></div>
              {buttonTypes.map(decoration => <div><Button variant={variant} decoration={decoration} textVariant={decoration === "ghost" ? "colored" : "default"}>{decoration}</Button></div>)}
            </div>
          ))
        }

      </div>

      <h4 class="numbered-title">Sizes</h4>

      <div class="flex flex-row">
        {
          buttonSizes.map(size => (
            <div>
              {
                size !== "icon" ? <Button size={size}>{size}</Button> :
                <Button size="icon" shape="circle" aria-label="instagram">
                  <Icon icon="instagram" width="1.5rem" height="1.5rem" color="inherit"/>
                </Button>
              }
            </div>
          ))
        }
      </div>

      <h4 class="numbered-title">Shapes</h4>

      <div class="flex flex-row items-center">
        {
          buttonShapes.map(shape => (
            <div><Button shape={shape}>{shape}</Button></div>
          ))
        }
      </div>
      
    </section>

    <section id="row" class="flow">
      <h2 class="numbered-title"><span>04</span> Row &amp; Pane</h2>

      <h3 class="numbered-title">Columns</h3>

      <Row>
        <Pane class="demo-pane">One column</Pane>
      </Row>

      <Row columns={2} id="row-two-columns">
        <Pane class="demo-pane">Two columns</Pane>
        <Pane class="demo-pane">1:1 by default</Pane>
      </Row>

      <Row columns={3} id="row-three-columns">
        <Pane class="demo-pane">Three</Pane>
        <Pane class="demo-pane">equal</Pane>
        <Pane class="demo-pane">columns</Pane>
      </Row>

      <h3 class="numbered-title">Ratio</h3>

      <Row columns={2} ratio="2:1">
        <Pane class="demo-pane">2:1 — the wide side</Pane>
        <Pane class="demo-pane">narrow side</Pane>
      </Row>

      <Row columns={2} ratio="1:2">
        <Pane class="demo-pane">1:2 — narrow side</Pane>
        <Pane class="demo-pane">the wide side</Pane>
      </Row>

      <h3 class="numbered-title">Gap</h3>

      {
        rowGaps.map(gap => (
          <Row columns={3} gap={gap}>
            <Pane class="demo-pane">gap</Pane>
            <Pane class="demo-pane">{gap}</Pane>
            <Pane class="demo-pane">gap</Pane>
          </Row>
        ))
      }

      <h3 class="numbered-title">Background</h3>

      {
        rowBackgrounds.map(background => (
          <Row columns={2} background={background} id={`row-${background}`} aria-label={`${background} background`}>
            <Pane>background="{background}"</Pane>
            <Pane align="end">Switches with the theme</Pane>
          </Row>
        ))
      }

      <h3 class="numbered-title">Width</h3>

      <Row columns={2} background="surface" width="full">
        <Pane>width="full"</Pane>
        <Pane align="end">Spans the whole parent</Pane>
      </Row>

      <Row columns={2} background="surface" width="contained">
        <Pane>width="contained"</Pane>
        <Pane align="end">Content stays within the site container</Pane>
      </Row>

      <h3 class="numbered-title">Pane alignment</h3>

      <Row columns={3}>
        {
          paneAlignments.map(align => (
            <Pane align={align} class="demo-pane demo-tall"><span>align="{align}"</span></Pane>
          ))
        }
      </Row>

      <Row columns={3}>
        {
          paneAlignments.map(valign => (
            <Pane valign={valign} class="demo-pane demo-tall"><span>valign="{valign}"</span></Pane>
          ))
        }
      </Row>

      <Row columns={2} ratio="2:1">
        <Pane>
          <Image src={dusk} alt="Mountains at dusk" ratio="3:2" />
        </Pane>
        <Pane center>
          <p>center</p>
          <p>Text sits in the middle of the taller image beside it, on both axes.</p>
        </Pane>
      </Row>

      <h3 class="numbered-title">Stacking</h3>

      <p>A Row stacks to one column when the Row itself is narrower than 40rem, whatever the viewport.</p>

      <div class="demo-narrow-container">
        <Row columns={3} id="row-in-narrow-container">
          <Pane class="demo-pane">Inside</Pane>
          <Pane class="demo-pane">a narrow</Pane>
          <Pane class="demo-pane">container</Pane>
        </Row>
      </div>
    </section>

    <section id="image" class="flow">
      <h2 class="numbered-title"><span>05</span> Image</h2>

      <h3 class="numbered-title">Sources and credit</h3>

      <Row columns={3}>
        <Pane>
          <Image id="image-local" src={dusk} alt="Mountains at dusk, local asset" credit="Kevin Verreault 2024" />
        </Pane>
        <Pane>
          <Image id="image-remote" src="/images/snow.jpg" alt="Snowfield, URL source" credit="Credit on a white photo" width={1200} height={800} />
        </Pane>
        <Pane>
          <Image src={dusk} alt="Mountains at dusk, no credit" />
        </Pane>
      </Row>

      <h3 class="numbered-title">Credit slot</h3>

      <Row columns={2}>
        <Pane>
          <Image src={dusk} alt="Mountains at dusk, custom credit" credit="Replaced by the slot">
            <Fragment slot="credit">© <a href="#image">Kevin Verreault</a> · Prints available</Fragment>
          </Image>
        </Pane>
      </Row>

      <h3 class="numbered-title">Ratio and fit</h3>

      <Row columns={3}>
        {
          imageRatios.map(ratio => (
            <Pane>
              <Image src={dusk} alt={`Mountains at dusk, ${ratio} cover`} ratio={ratio} credit={`ratio="${ratio}"`} />
            </Pane>
          ))
        }
      </Row>

      <Row columns={2}>
        <Pane>
          <Image src={dusk} alt="Mountains at dusk, square cover" ratio="1:1" fit="cover" credit='fit="cover"' />
        </Pane>
        <Pane>
          <Image src={dusk} alt="Mountains at dusk, square contain" ratio="1:1" fit="contain" credit='fit="contain"' class="demo-contain" />
        </Pane>
      </Row>
    </section>

    <section id="form-controls" class="flow">
      <h2 class="numbered-title"><span>06</span> Form controls</h2>

      <p>Every control wraps a native element, so submission and validation work without JavaScript. Tab through the fields to see the focus ring.</p>

      <div id="form-alignment" class="flow">
        <h3 class="numbered-title">Sizes</h3>

        <p>An Input, a Select and a Button of the same size are the same height.</p>

        {
          controlSizes.map(size => (
            <div class="demo-control-row">
              <Input size={size} id={`align-input-${size}`} aria-label={`${size} input`} placeholder={`size="${size}"`} />
              <Select size={size} id={`align-select-${size}`} aria-label={`${size} select`}><option>{size}</option></Select>
              <Button size={size} id={`align-button-${size}`}>{size}</Button>
              <Button size={size} decoration="outline">outline</Button>
            </div>
          ))
        }
      </div>

      <div id="label" class="flow">
        <h3 class="numbered-title">Label</h3>

        <div class="demo-form-grid">
          <div class="demo-stack">
            <Label for="label-standalone">A standalone Label</Label>
            <Input id="label-standalone" name="standalone" />
          </div>
        </div>
      </div>

      <div id="input" class="flow">
        <h3 class="numbered-title">Input</h3>

        <div class="demo-form-grid">
          <FormField id="input-default" label="Name"><Input name="name" autocomplete="name" placeholder="Jane Doe" /></FormField>
          <FormField id="input-hint" label="Email" hint="We only use it to answer you."><Input type="email" name="email" autocomplete="email" placeholder="you@example.com" /></FormField>
          <FormField id="input-error" label="Postal code" error="Enter a postal code such as H2X 1Y4."><Input name="postal-code" value="H2X" pattern="[A-Za-z]\d[A-Za-z] ?\d[A-Za-z]\d" /></FormField>
          <FormField id="input-disabled" label="Disabled"><Input name="disabled" value="Can't touch this" disabled /></FormField>
          <FormField id="input-readonly" label="Read-only"><Input name="readonly" value="Order #1024" readonly /></FormField>
        </div>
      </div>

      <div id="textarea" class="flow">
        <h3 class="numbered-title">Textarea</h3>

        <div class="demo-form-grid">
          <FormField id="textarea-default" label="Message" hint="A few words about the print you want."><Textarea name="message" placeholder="Hello…" /></FormField>
          <FormField id="textarea-error" label="Message" error="The message can't be empty."><Textarea name="message-error" required /></FormField>
          <FormField id="textarea-disabled" label="Disabled"><Textarea name="message-disabled" value="Disabled" disabled /></FormField>
          <FormField id="textarea-readonly" label="Read-only"><Textarea name="message-readonly" value="Sent on 12 May." readonly /></FormField>
        </div>
      </div>

      <div id="select" class="flow">
        <h3 class="numbered-title">Select</h3>

        <div class="demo-form-grid">
          <FormField id="select-default" label="Category">
            <Select name="category">
              <option value="birds">Oiseaux</option>
              <option value="mammals">Mammifères</option>
              <option value="landscapes">Paysages</option>
            </Select>
          </FormField>
          <FormField id="select-error" label="Format" error="Pick a format.">
            <Select name="format" required>
              <option value="">Choose…</option>
              <option value="a4">A4</option>
            </Select>
          </FormField>
          <FormField id="select-disabled" label="Disabled">
            <Select name="select-disabled" disabled><option>Unavailable</option></Select>
          </FormField>
        </div>

        <p>A native select has no read-only state; use a read-only Input instead.</p>
      </div>

      <div id="checkbox" class="flow">
        <h3 class="numbered-title">Checkbox</h3>

        <div class="demo-form-grid">
          <FormField id="checkbox-default" label="Subscribe to the newsletter"><Checkbox name="newsletter" /></FormField>
          <FormField id="checkbox-checked" label="Checked" hint="One email a month."><Checkbox name="checked" checked /></FormField>
          <FormField id="checkbox-error" label="I accept the terms" error="You must accept the terms."><Checkbox name="terms" required /></FormField>
          <FormField id="checkbox-disabled" label="Disabled"><Checkbox name="checkbox-disabled" disabled /></FormField>
          <FormField id="checkbox-disabled-checked" label="Disabled and checked"><Checkbox name="checkbox-disabled-checked" checked disabled /></FormField>
        </div>
      </div>

      <div id="radio-group" class="flow">
        <h3 class="numbered-title">Radio group</h3>

        <div class="demo-form-grid">
          <RadioGroup id="radio-group-standalone" name="format-standalone" legend="Standalone, with a legend" options={printFormats} value="a4" />
          <FormField id="radio-group-field" label="Print size" hint="Framing is quoted separately."><RadioGroup name="format-field" options={printFormats} /></FormField>
          <FormField id="radio-group-error" label="Print size" error="Pick a print size."><RadioGroup name="format-error" options={printFormats} required /></FormField>
          <FormField id="radio-group-disabled" label="Disabled"><RadioGroup name="format-disabled" options={printFormats} value="a3" disabled /></FormField>
          <FormField id="radio-group-horizontal" label="Horizontal"><RadioGroup name="format-horizontal" orientation="horizontal" options={[{ value: "portrait", label: "Portrait" }, { value: "landscape", label: "Landscape" }]} value="landscape" /></FormField>
        </div>
      </div>

      <div id="switch" class="flow">
        <h3 class="numbered-title">Switch</h3>

        <div class="demo-form-grid">
          <FormField id="switch-default" label="Email me when new prints arrive"><Switch name="alerts" /></FormField>
          <FormField id="switch-checked" label="On" hint="Checkbox semantics, toggle look."><Switch name="on" checked /></FormField>
          <FormField id="switch-error" label="Required" error="Turn this on to continue."><Switch name="required-switch" required /></FormField>
          <FormField id="switch-disabled" label="Disabled"><Switch name="switch-disabled" disabled /></FormField>
          <FormField id="switch-disabled-checked" label="Disabled and on"><Switch name="switch-disabled-checked" checked disabled /></FormField>
        </div>
      </div>

      <div id="form-field" class="flow">
        <h3 class="numbered-title">Form field</h3>

        <p>A contact form built from FormFields. Submitting it empty shows the browser's own validation.</p>

        <form id="form-field-demo" class="demo-form flow" action="#form-field">
          <FormField label="Name"><Input name="contact-name" autocomplete="name" required /></FormField>
          <FormField label="Email" hint="We only use it to answer you."><Input type="email" name="contact-email" autocomplete="email" required /></FormField>
          <FormField label="Print size"><RadioGroup name="contact-format" options={printFormats} required /></FormField>
          <FormField label="Message"><Textarea name="contact-message" required /></FormField>
          <FormField label="Subscribe to the newsletter"><Checkbox name="contact-newsletter" /></FormField>
          <div><Button type="submit">Send</Button></div>
        </form>
      </div>
    </section>
    <section id="card" class="flow">
      <h2 class="numbered-title"><span>07</span> Card</h2>

      <Row columns={3}>
        <Pane>
          <Card href="#card" id="card-linked">
            <Image slot="media" src={dusk} alt="Mountains at dusk" ratio="3:2" credit="Kevin Verreault 2024" />
            <h3 slot="header" class="text-lg">Dusk over the hills</h3>
            <p>The whole card is one link; the image keeps its credit footer.</p>
            <Fragment slot="footer"><Badge>New</Badge> <span>From 45 $</span></Fragment>
          </Card>
        </Pane>
        <Pane>
          <Card id="card-actions">
            <h3 slot="header" class="text-lg">Calendar 2025</h3>
            <p>A card that doesn't link can hold its own actions.</p>
            <Fragment slot="footer"><Button size="small">Add to cart</Button><Button size="small" variant="muted">Details</Button></Fragment>
          </Card>
        </Pane>
        <Pane>
          <Card id="card-body-only" as="div">
            <p>Only the body is given, so only the body renders.</p>
          </Card>
        </Pane>
      </Row>
    </section>

    <section id="badge" class="flow">
      <h2 class="numbered-title"><span>08</span> Badge</h2>

      <div class="flex flex-row items-center">
        {badgeVariants.map(variant => <Badge variant={variant}>{variant}</Badge>)}
      </div>

      <p>Heron at dawn <Badge variant="secondary">New</Badge> <Badge variant="danger">Sold out</Badge></p>
    </section>

    <section id="avatar" class="flow">
      <h2 class="numbered-title"><span>09</span> Avatar</h2>

      <h3 class="numbered-title">Image</h3>

      <div class="flex flex-row items-center">
        {avatarSizes.map(size => <Avatar src={dusk} name="Kevin Verreault" size={size} />)}
        <Avatar src="/images/snow.jpg" name="Remote source" />
      </div>

      <h3 class="numbered-title">Initials fallback</h3>

      <div class="flex flex-row items-center" id="avatar-initials">
        {avatarSizes.map(size => <Avatar name="Kevin Verreault" size={size} />)}
        <Avatar name="Élodie" />
      </div>

      <div class="flex flex-row items-center">
        <Avatar name="Kevin Verreault" alt="" />
        <span>Kevin Verreault (decorative avatar next to the name)</span>
      </div>
    </section>

    <section id="separator" class="flow">
      <h2 class="numbered-title"><span>10</span> Separator</h2>

      <p>Decorative (role="none"), the default:</p>
      <Separator />
      <p>Semantic (role="separator"), when the division matters to screen-reader users:</p>
      <Separator decorative={false} id="separator-semantic" />

      <div class="flex flex-row items-center">
        <span>Oiseaux</span>
        <Separator orientation="vertical" />
        <span>Mammifères</span>
        <Separator orientation="vertical" decorative={false} />
        <span>Paysages</span>
      </div>
    </section>

    <section id="table" class="flow">
      <h2 class="numbered-title"><span>11</span> Table</h2>

      <Table caption="Print sizes and prices" columns={printColumns} rows={printRows} rowHeader="size" />

      <Table caption="Striped and hover" columns={printColumns} rows={printRows} rowHeader="size" striped hover id="table-striped" />
    </section>

    <section id="skeleton" class="flow">
      <h2 class="numbered-title"><span>12</span> Skeleton</h2>

      <Row columns={3}>
        <Pane>
          <div class="flow" aria-busy="true" aria-label="Loading a product" id="skeleton-demo" style="width: 100%;">
            <Skeleton style="aspect-ratio: 3 / 2" />
            <div class="flex flex-row items-center">
              <Skeleton shape="circle" />
              <div class="flow" style="flex: 1; --flow-space: .5rem;">
                <Skeleton shape="line" />
                <Skeleton shape="line" style="width: 60%" />
              </div>
            </div>
          </div>
        </Pane>
      </Row>
    </section>

    <section id="gallery" class="flow">
      <h2 class="numbered-title"><span>13</span> Gallery</h2>

      <Gallery images={galleryImages} id="gallery-default" aria-label="Paysages" />

      <h3 class="numbered-title">Small square thumbnails</h3>

      <Gallery images={galleryImages} ratio="1:1" columnWidth="small" gap="small" aria-label="Paysages, small" />
    </section>

    <section id="alert" class="flow">
      <h2 class="numbered-title"><span>14</span> Alert</h2>

      <h3 class="numbered-title">Variants</h3>

      {
        alerts.map(({ variant, icon, title, message }) => (
          <Alert variant={variant} icon={icon} title={title} id={`alert-${variant}`}>{message}</Alert>
        ))
      }

      <h3 class="numbered-title">Without icon or title</h3>

      <Alert>info and success use role="status"; warning and danger use role="alert".</Alert>
    </section>

    <section id="toast" class="flow">
      <h2 class="numbered-title"><span>15</span> Toast</h2>

      <p>One Toast region sits in the layout. Any script queues a message in it with <code>toast(message, &#123; variant, duration &#125;)</code>.</p>

      <div class="flex flex-row" style="flex-wrap: wrap;">
        <Button id="toast-info" variant="muted" data-toast="Prints ship within five business days." data-toast-variant="info">info</Button>
        <Button id="toast-success" variant="muted" data-toast="Added to cart" data-toast-variant="success">success</Button>
        <Button id="toast-warning" variant="muted" data-toast="Only three prints remain" data-toast-variant="warning">warning</Button>
        <Button id="toast-danger" variant="muted" data-toast="Payment declined" data-toast-variant="danger">danger</Button>
        <Button id="toast-short" variant="secondary" data-toast="Saved for two seconds" data-toast-variant="success" data-toast-duration="2000">2 second toast</Button>
      </div>
    </section>

    <section id="tabs" class="flow">
      <h2 class="numbered-title"><span>16</span> Tabs</h2>

      <p>Without JavaScript every panel shows under its heading.</p>

      <Tabs label="Print formats" id="tabs-print-formats">
        <TabPanel label="Small"><p>20 × 30 cm, printed on matte paper.</p></TabPanel>
        <TabPanel label="Medium"><p>40 × 60 cm, printed on fine-art paper.</p></TabPanel>
        <TabPanel label="Large"><p>60 × 90 cm, mounted on aluminium.</p></TabPanel>
      </Tabs>
    </section>

    <section id="breadcrumbs" class="flow">
      <h2 class="numbered-title"><span>17</span> Breadcrumbs</h2>

      <Breadcrumbs items={breadcrumbItems} aria-label="Fil d'Ariane" />
    </section>

    <section id="pagination" class="flow">
      <h2 class="numbered-title"><span>18</span> Pagination</h2>

      <Pagination items={paginationItems} current={3} />
      <Pagination items={paginationItems} current={1} aria-label="First page" />
      <Pagination items={paginationItems} current={5} aria-label="Last page" previousLabel="Précédent" nextLabel="Suivant" />
    </section>

    <section id="footer" class="flow">
      <h2 class="numbered-title"><span>19</span> Footer</h2>

      <Footer groups={footerGroups} social={footerSocial} copyright="Kevin Verreault 2024" />
    </section>

    <section id="dialog" class="flow">
      <h2 class="numbered-title"><span>20</span> Dialog</h2>

      <p>A native modal dialog: Escape or a click outside closes it, and focus returns to the Button that opened it.</p>

      <Dialog id="dialog-demo" title="Order a print" description="Choose a size; framing is quoted separately.">
        <Button slot="trigger" id="dialog-demo-trigger">Order a print</Button>
        <FormField label="Print size"><RadioGroup name="dialog-format" options={printFormats} value="a4" /></FormField>
        <Fragment slot="footer">
          <Button variant="muted" value="cancel">Cancel</Button>
          <Button value="order">Add to cart</Button>
        </Fragment>
      </Dialog>

      <h3 class="numbered-title">Sizes</h3>

      <div class="flex flex-row" style="flex-wrap: wrap;">
        {
          dialogSizes.map(size => (
            <Dialog id={`dialog-${size}`} size={size} title={`size="${size}"`}>
              <Button slot="trigger" variant="muted">{size}</Button>
              <p>A {size} dialog. Its width shrinks to fit narrow screens.</p>
            </Dialog>
          ))
        }
      </div>
    </section>

    <section id="alert-dialog" class="flow">
      <h2 class="numbered-title"><span>21</span> Alert dialog</h2>

      <p>Asks for an explicit choice: no close button, and a click outside doesn't close it. Escape cancels.</p>

      <AlertDialog id="alert-dialog-demo" title="Delete this print?" description="It will be removed from your cart. This cannot be undone." actionLabel="Delete">
        <Button slot="trigger" id="alert-dialog-demo-trigger" variant="danger">Delete print</Button>
      </AlertDialog>
      <AlertDialog id="alert-dialog-primary" title="Publish this gallery?" description="Visitors will see it on the portfolio page." actionLabel="Publish" actionVariant="primary">
        <Button slot="trigger" variant="muted">Publish gallery</Button>
      </AlertDialog>
      <p>Last choice: <output id="alert-dialog-result">none</output></p>
    </section>

    <section id="sheet" class="flow">
      <h2 class="numbered-title"><span>22</span> Sheet</h2>

      <div class="flex flex-row" style="flex-wrap: wrap;">
        {
          sheetSideNames.map(side => (
            <Sheet id={`sheet-${side}`} side={side} title={`side="${side}"`} description="A dialog attached to one edge of the viewport.">
              <Button slot="trigger" id={`sheet-${side}-trigger`} variant="secondary">{side}</Button>
              <p>Use it for a mobile menu or a cart panel.</p>
            </Sheet>
          ))
        }
      </div>
    </section>

    <section id="lightbox" class="flow">
      <h2 class="numbered-title"><span>23</span> Lightbox</h2>

      <p>One Lightbox on the page opens every <a href="#gallery">Gallery</a> image at full size, with its credit. The arrow keys move to the previous or next photo.</p>

      <Lightbox id="lightbox-demo" />

      <h3 class="numbered-title">Captioned, responsive photos</h3>

      <p>A site gallery with its own layout opens in the same Lightbox through the <code>gallery-open</code> contract. Its links can also carry a <code>srcset</code> and <code>sizes</code> for the full-size photo, and a caption that shows under it.</p>

      <ul data-gallery id="lightbox-captioned" class="demo-host-gallery" role="list" aria-label="Paysages légendés">
        {
          captionedPhotos.map(photo => (
            <li>
              <a href={photo.href} data-gallery-link data-srcset={photo.srcset} data-sizes={photo.sizes} data-caption={photo.caption} data-credit={photo.credit} data-width="1200" data-height="800">
                <Image src={photo.thumbnail} alt={photo.alt} width={1200} height={800} ratio="1:1" sizes="10rem" />
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="popover" class="flow">
      <h2 class="numbered-title"><span>24</span> Popover</h2>

      <p>A small panel anchored to its trigger. Escape or a click outside closes it.</p>

      <Popover id="popover-demo" label="Print details">
        <Button slot="trigger" id="popover-demo-trigger" variant="muted">Print details</Button>
        <div class="flow" style="--flow-space: .5rem;">
          <p class="text-lg">Fine-art print</p>
          <p class="text-sm">Pigment ink on 310 g cotton rag, signed and numbered on the back.</p>
        </div>
      </Popover>
    </section>

    <section id="dropdown-menu" class="flow">
      <h2 class="numbered-title"><span>25</span> Dropdown menu</h2>

      <p>Open it with a click, Enter, Space or the arrow keys; move with the arrows, Home and End; Escape closes it.</p>

      <DropdownMenu id="dropdown-menu-demo" label="Print actions" items={printActions}>
        <Button slot="trigger" id="dropdown-menu-demo-trigger" variant="muted">Actions</Button>
      </DropdownMenu>
      <p>Last action: <output id="dropdown-menu-result">none</output></p>
    </section>

    <section id="tooltip" class="flow">
      <h2 class="numbered-title"><span>26</span> Tooltip</h2>

      <p>Shows on hover and on keyboard focus, and describes its trigger. It sits above, or below when there is no room above.</p>

      <div class="flex flex-row items-center">
        {
          footerSocial.map(({ icon, text }) => (
            <Tooltip text={`Follow on ${text}`} id={`tooltip-${icon}`}>
              <Button size="icon" shape="circle" variant="muted" aria-label={text} id={`tooltip-${icon}-trigger`}>
                <Icon icon={icon} width="1.5rem" height="1.5rem" color="inherit" aria-hidden="true" />
              </Button>
            </Tooltip>
          ))
        }
      </div>
    </section>
  </div>
</Layout>

<script>
  import { toast, type ToastVariant } from '../components/feedback/toast';
  import { handleGalleryClick } from '../components/media/gallery-open';

  // What a host site does for its own galleries; the Gallery component installs the same listener.
  document.addEventListener('click', handleGalleryClick);

  const alertDialog = document.querySelector<HTMLDialogElement>('#alert-dialog-demo')!;
  alertDialog.addEventListener('close', () => {
    document.querySelector('#alert-dialog-result')!.textContent = alertDialog.returnValue || 'none';
  });

  document.querySelector('#dropdown-menu-demo')!.addEventListener('click', event => {
    const item = (event.target as Element).closest<HTMLButtonElement>('button[role="menuitem"]');
    if (item) document.querySelector('#dropdown-menu-result')!.textContent = item.value;
  });

  document.querySelectorAll<HTMLElement>('[data-toast]').forEach(trigger => {
    trigger.addEventListener('click', () => toast(trigger.dataset.toast!, {
      variant: trigger.dataset.toastVariant as ToastVariant | undefined,
      duration: Number(trigger.dataset.toastDuration) || undefined
    }));
  });
</script>

