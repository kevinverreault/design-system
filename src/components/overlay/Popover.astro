---
import '../../styles/global.css'
import type { HTMLAttributes } from "astro/types";
import { nextOverlayId, wireTrigger } from './wire-trigger';

/**
 * A small panel of extra content, anchored below its trigger. It uses the
 * `popover` attribute, so the trigger toggles it without JavaScript, and
 * Escape or a click outside closes it. It is a non-modal dialog named by
 * `label`.
 *
 * Slots: `trigger` (a Button that toggles it) and the default slot (the
 * panel). Unknown attributes go on the panel.
 */
export interface Props extends HTMLAttributes<"div"> {
  /** Accessible name of the panel. */
  label: string;
}

const { label, id: givenId, class: className, ...attributes } = Astro.props;

const id = givenId || nextOverlayId("popover");

if (typeof label !== "string" || label.trim() === "") {
  throw new Error(`Popover '${id}' needs a non-empty label: it is the panel's accessible name.`);
}

const trigger = Astro.slots.has("trigger")
  ? wireTrigger(await Astro.slots.render("trigger"), { popovertarget: id, "aria-controls": id })
  : undefined;

if (!trigger) {
  throw new Error(`Popover '${label}' needs an element, such as a Button, in its trigger slot.`);
}
---

<popover-root>
  <Fragment set:html={trigger} />
  <div {...attributes} id={id} popover="auto" role="dialog" aria-label={label} class:list={["popover", className]}>
    <slot />
  </div>
</popover-root>

<style>
  popover-root {
    display: contents;
  }

  .popover {
    width: max-content;
    max-width: min(20rem, calc(100vw - 2 * var(--space-sm)));
    padding: var(--space-sm);
    border: 1px solid hsl(var(--color-on-background) / .15);
    border-radius: var(--border);
    background-color: hsl(var(--color-background));
    color: hsl(var(--color-on-background));
    box-shadow: 0 0.5rem 1.5rem hsl(var(--color-scrim) / .15);
  }

  @supports (position-area: block-end) {
    .popover {
      inset: auto;
      margin: 0.5rem 0;
      position-area: block-end span-inline-end;
      position-try-fallbacks: flip-block, flip-inline;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .popover:popover-open {
      animation: popover-in 150ms ease-out;
    }
  }

  @keyframes popover-in {
    from {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
  }

  @media (forced-colors: active) {
    .popover {
      border-color: CanvasText;
    }
  }
</style>

<script>
  import { anchorPopover, syncExpanded } from './popover';

  class PopoverRoot extends HTMLElement {
    connectedCallback() {
      const panel = this.querySelector<HTMLElement>('[popover]');
      const trigger = panel && this.querySelector<HTMLElement>(`[popovertarget="${panel.id}"]`);

      if (!panel || !trigger) return;

      anchorPopover(panel, trigger, 'bottom');
      syncExpanded(panel, trigger);
    }
  }

  customElements.define('popover-root', PopoverRoot);
</script>
