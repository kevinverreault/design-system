---
import '../../styles/global.css'
import { cva, type VariantProps } from 'cva';
import type { HTMLAttributes } from "astro/types";

const table = cva("table", {
  variants: {
    striped: {
      true: "striped"
    },
    hover: {
      true: "hover"
    }
  }
});

export interface TableColumn {
  /** The key read from each row. */
  key: string;
  label: string;
  /** Use "end" for numbers and prices. */
  align?: "start" | "center" | "end";
}

export type TableRow = Record<string, string | number>;

/**
 * Unknown attributes (id, class, data-*, …) go on the root, a wrapper that
 * scrolls the table horizontally when it is wider than its container.
 */
export interface Props
  extends HTMLAttributes<"div">,
    VariantProps<typeof table> {
  /** Required for an accessible table; the `caption` slot can replace it. */
  caption?: string;
  columns: readonly TableColumn[];
  rows: readonly TableRow[];
  /** Key of the column whose cells label their row (rendered as th scope="row"). */
  rowHeader?: string;
}

const { caption, columns, rows, rowHeader, striped = false, hover = false, class: className, ...attributes } = Astro.props;

if (!caption && !Astro.slots.has("caption")) {
  throw new Error("Table requires a caption (prop or slot) that describes its content.");
}

if (rowHeader && !columns.some(column => column.key === rowHeader)) {
  throw new Error(`Table rowHeader '${rowHeader}' is not one of its column keys (${columns.map(column => column.key).join(", ")}).`);
}

const alignment = (column: TableColumn) => `align-${column.align ?? "start"}`;
---

<div {...attributes} class:list={["table-root", className]}>
  <table class:list={[table({ striped, hover }), "ff-sans-normal"]}>
    <caption>
      {Astro.slots.has("caption") ? <slot name="caption" /> : caption}
    </caption>
    <thead>
      <tr>
        {columns.map(column => <th scope="col" class={alignment(column)}>{column.label}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map(row => (
          <tr>
            {
              columns.map(column => column.key === rowHeader
                ? <th scope="row" class={alignment(column)}>{row[column.key]}</th>
                : <td class={alignment(column)}>{row[column.key]}</td>)
            }
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .table-root {
    max-width: 100%;
    overflow-x: auto;
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-md);
  }

  caption {
    padding-bottom: 0.75em;
    text-align: start;
    font-size: var(--fs-sm);
    color: hsl(var(--color-on-background) / .75);
  }

  th,
  td {
    padding: 0.75em 1em;
    border-bottom: 1px solid hsl(var(--color-on-background) / .15);
  }

  th {
    font-weight: 700;
  }

  thead th {
    font-family: var(--ff-sans-condensed);
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 1px;
    color: hsl(var(--color-on-background) / .75);
    border-bottom-color: hsl(var(--color-on-background) / .4);
  }

  .align-start { text-align: start; }
  .align-center { text-align: center; }
  .align-end { text-align: end; }

  .striped tbody tr:nth-child(even) {
    background-color: hsl(var(--color-surface) / .5);
  }

  .hover tbody tr:hover {
    background-color: hsl(var(--color-surface));
  }

  @media (forced-colors: active) {
    .hover tbody tr:hover {
      outline: 1px solid Highlight;
      outline-offset: -1px;
    }
  }
</style>
