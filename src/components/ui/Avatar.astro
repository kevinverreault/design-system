---
import '../../styles/global.css'
import { Image as OptimizedImage } from 'astro:assets';
import { cva, type VariantProps } from 'cva';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from "astro/types";

const avatar = cva("avatar", {
  variants: {
    size: {
      small: "size-small",
      medium: "size-medium",
      large: "size-large"
    }
  }
});

export interface Props
  extends HTMLAttributes<"span">,
    VariantProps<typeof avatar> {
  /** The person shown; it names the avatar and gives the initials fallback. */
  name: string;
  /** An imported local asset or a remote URL. Without it, the initials show. */
  src?: ImageMetadata | string;
  /** Defaults to the name. Use an empty string when the name is already shown next to the avatar. */
  alt?: string;
}

/** Twice the large size, so local images stay sharp on high-density screens. */
const LOCAL_IMAGE_WIDTH = 128;

const { name, src, alt, size = "medium", class: className, ...attributes } = Astro.props;

const words = (name ?? "").trim().split(/\s+/).filter(Boolean);

if (words.length === 0) {
  throw new Error("Avatar requires a name, used for its accessible name and its initials.");
}

const label = alt ?? name.trim();
const initialOf = (word: string) => Array.from(word)[0].toLocaleUpperCase();
const initials = words.length === 1
  ? initialOf(words[0])
  : initialOf(words[0]) + initialOf(words[words.length - 1]);
---

{
  src
    ? <span {...attributes} class:list={[avatar({ size }), className]}>
        {
          typeof src === "string"
            ? <img src={src} alt={label} loading="lazy" decoding="async" />
            : <OptimizedImage src={src} alt={label} width={LOCAL_IMAGE_WIDTH} />
        }
      </span>
    : <span {...attributes} role={label ? "img" : undefined} aria-label={label || undefined} class:list={[avatar({ size }), className]}>
        <span class="initials" aria-hidden="true">{initials}</span>
      </span>
}

<style>
  .avatar {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: var(--avatar-size);
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: 50%;
    background-color: hsl(var(--color-surface));
    color: hsl(var(--color-on-surface));
    font-family: var(--ff-sans-condensed);
    font-weight: 700;
    line-height: 1;
    vertical-align: middle;
    user-select: none;
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .size-small { --avatar-size: 2rem; font-size: var(--fs-sm); }
  .size-medium { --avatar-size: 2.5rem; font-size: var(--fs-md); }
  .size-large { --avatar-size: 4rem; font-size: var(--fs-xl); }
</style>
