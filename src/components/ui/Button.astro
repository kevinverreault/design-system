---
import '../../styles/global.css'
import { cva, type VariantProps } from 'cva';
import type { HTMLAttributes } from "astro/types";
import { containsInteractiveContent } from '../../lib/interactive-content';

const button = cva("button", {
  variants: {
    variant: {
      primary: "primary",
      secondary: "secondary",
      muted: "muted",
      danger: "danger"
    },
    decoration: {
      plain: "plain",
      outline: "outline",
      ghost: "ghost",
      underline: "underline"
    },
    size: {
      icon: "icon",
      small: "text-sm",
      medium: "text-md",
      large: "text-xl",
      "extra-large":  "text-2xl"
    },
    shape: {
      rectangle: "",
      square: "square",
      circle: "circle",
      rounded: "rounded"
    },
    textVariant: {
      default: "default-text",
      colored: "colored-text"
    }
  }
});

type LinkAttributes = Pick<HTMLAttributes<"a">, "href" | "target" | "rel" | "hreflang" | "referrerpolicy" | "download">;

/**
 * With `href`, the button is a link styled as a button: an anchor with the
 * same classes, so every variant works on it. It then refuses the attributes
 * that only work on a button, and, being a single anchor, any interactive
 * element (link, button, form control, media controls, tabindex) in its slot.
 */
export interface Props
  extends Omit<HTMLAttributes<"button">, keyof LinkAttributes>,
    LinkAttributes,
    VariantProps<typeof button> {
    }
      
const { 
  variant = "primary", 
  decoration = "plain", 
  size = "medium",
  shape = "rectangle", 
  textVariant = "default", 
  ...attributes
  } = Astro.props;

/** Attributes that do nothing on an anchor; `disabled` would leave a "disabled" link that still navigates. */
const BUTTON_ONLY = new Set([
  "type", "disabled", "name", "value",
  "form", "formaction", "formenctype", "formmethod", "formnovalidate", "formtarget",
  "popovertarget", "popovertargetaction", "command", "commandfor"
]);

// null, like undefined, renders no href: that is not a link.
const linked = attributes.href != null;
// false, null and undefined render no attribute, so they pass.
const refusedAttribute = linked
  ? Object.entries(attributes).find(([name, value]) => BUTTON_ONLY.has(name.toLowerCase()) && value != null && value !== false)?.[0]
  : undefined;

if (refusedAttribute) {
  throw new Error(`A linked Button (href="${attributes.href}") is an anchor, where ${refusedAttribute} does nothing; remove ${refusedAttribute} or href.`);
}

const content = await Astro.slots.render("default");

if (linked && containsInteractiveContent(content)) {
  throw new Error(`A linked Button (href="${attributes.href}") is a single anchor and can't contain interactive elements; remove the nested link, button, form control or tabindex.`);
}

const Element = linked ? "a" : "button";
---

<Element {...attributes} class:list={[button({ variant, decoration, size,  shape, textVariant}), "button", "ff-sans-normal"]}>
  <Fragment set:html={content} />
</Element>

<style>

  /*
   * Padding, line height and border come from the --control-* tokens shared
   * with Input and Select, so a Button lines up with them on one row. Every
   * decoration has the same border width (transparent unless outlined), so
   * all buttons of a size are the same height, and the border shows in
   * forced-colours mode.
   *
   * A linked Button is an anchor, which inherits the text styles a button
   * resets, so the button's defaults are set here for both.
   */
  .button {
    font-style: normal;
    font-weight: normal;
    letter-spacing: normal;
    word-spacing: normal;
    text-transform: none;
    text-indent: 0;
    text-shadow: none;
    --border-radius: var(--border);
    padding: calc(var(--control-padding-block) - var(--control-border-width)) calc(var(--control-padding-inline) - var(--control-border-width));
    line-height: var(--control-line-height);
    border-radius: var(--border-radius);
    position: relative;
    display: inline-grid;
    place-items: center;
    border: var(--control-border-width) solid transparent;
    margin: 0;
    text-decoration: none;
    cursor: pointer;
    text-align: center;
    transition: background-color 200ms ease-in-out, color 200ms ease-in-out;
  }

  .button:active {
    transform: scale(0.975);
    /* box-shadow: 0 0 0 .1rem var(--main-color); */
  }

  .primary {
    --main-color: hsl(var(--color-primary));
    --text-on-main-color: hsl(var(--color-on-primary));
    --accent-color: hsl(var(--color-primary-variant));
  }

  .secondary {
    --main-color: hsl(var(--color-secondary));
    --text-on-main-color: hsl(var(--color-on-secondary));
    --accent-color: hsl(var(--color-secondary-variant));
  }

  .muted {
    --main-color: hsl(var(--color-surface));
    --text-on-main-color: hsl(var(--color-on-surface));
    --accent-color: hsl(var(--color-surface) / .8);
  }

  .danger {
    --main-color: hsl(var(--color-error) / .75);
    --text-on-main-color: hsl(var(--color-on-error));
    --accent-color: hsl(var(--color-error) / .6);
  }

  .default-text {
    --text-on-background-color: var(--text-on-main-color);
  }

  .colored-text {
    --text-on-background-color: var(--main-color);
  }

  .colored-text.muted {
    --text-on-background-color: var(--text-on-main-color);
  }

  .plain {
    background-color: var(--main-color);
    color: var(--text-on-main-color);
  }

  .plain:hover,
  .plain:focus {
    background-color: var(--accent-color);
  }

  .outline {
    background-color: hsl(var(--color-background));
    border-color: var(--main-color);
    color: hsl(var(--color-on-background));
  }

  .outline:hover,
  .outline:focus {
    background-color: var(--main-color);
    color: var(--text-on-main-color);
  }

  .ghost {
    background-color: hsl(var(--color-background));
    color: var(--text-on-background-color);
  }

  .ghost:hover,
  .ghost:focus {
    background-color: var(--main-color);
    color: var(--text-on-main-color);
  }

  .underline {
    background-color: hsl(var(--color-background));
    color: hsl(var(--color-on-background));
  }

  .underline::after {
    content: "";
    position: absolute;
    left: 50%;
    transform: translate(-50%, 0);
    bottom: 20%;
    height: 2px;
    width: calc(100% - 3em);
    background-color: var(--main-color);
    transition: all cubic-bezier(.43,.045,.1,.95) .35s;
  }

  .underline:hover::after,
  .underline:focus::after {
    box-shadow: 0 1px 1px var(--main-color);
  }

  .square {
    aspect-ratio: 1;
    padding: 1em;
  }

  .circle {
    aspect-ratio: 1;
    border-radius: 50%;
    padding: 1em;
  }

  .icon {
    padding: 0.5em;
  }

  .rounded {
    --border-radius: 9999px;
    border-radius: 9999px;
  }

  /*
   * Browsers force a button's colours to their own, and differently: an
   * anchor would get the link colour, and only some keep the transparency of
   * the danger and muted backgrounds or mark focus. So every Button, linked
   * or not, gets the button system colours, and a Highlight border on focus.
   */
  @media (forced-colors: active) {
    .button,
    .button:is(:hover, :focus) {
      color: ButtonText;
      background-color: ButtonFace;
      border-color: ButtonBorder;
    }

    .button:focus {
      border-color: Highlight;
    }
  }

</style>
