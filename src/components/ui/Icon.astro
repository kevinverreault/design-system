---
import { parseSvg } from '../../lib/svg';
import type { HTMLAttributes } from "astro/types";

export interface Props 
  extends HTMLAttributes<"svg"> {
  icon: string;
}

function getSVG(name: string) {
  const filepath = `/src/svg/${name}.svg`;
  const files = import.meta.glob<string>('/src/svg/**/*.svg', {
    eager: true,
    query: '?raw',
    import: 'default'
  });

  if (!(filepath in files)) {
    throw new Error(`${filepath} not found`);
  }

  try {
    const { attributes, innerHTML } = parseSvg(files[filepath]);

    return {
      baseAttributes: attributes,
      innerHTML,
    };
  } catch (error) {
    throw new Error(`${filepath}: ${(error as Error).message}`, { cause: error });
  }
}

const { icon, ...attributes } = Astro.props as Props;
const { baseAttributes, innerHTML } = getSVG(icon);

const svgAttributes = { ...baseAttributes, ...attributes };
---

<svg
  {...svgAttributes}
  set:html={innerHTML}
>
</svg>
