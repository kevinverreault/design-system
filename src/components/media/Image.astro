---
import '../../styles/global.css'
import './credit.css'
import { Image as OptimizedImage } from 'astro:assets';
import { cva, type VariantProps } from 'cva';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from "astro/types";
import { creditText } from './credit';

const image = cva("image", {
  variants: {
    ratio: {
      auto: "ratio-auto",
      "1:1": "ratio-1-1",
      "3:2": "ratio-3-2",
      "2:3": "ratio-2-3",
      "4:3": "ratio-4-3",
      "3:4": "ratio-3-4",
      "16:9": "ratio-16-9"
    },
    fit: {
      cover: "fit-cover",
      contain: "fit-contain"
    }
  }
});

/** Attributes that belong to the image itself; they go on the img. */
type ImageElementAttributes = Pick<HTMLAttributes<"img">, "loading" | "decoding" | "fetchpriority" | "sizes">;

/**
 * Unknown attributes (id, class, aria-*, data-*, …) go on the root figure, as
 * for every component. The image attributes above, plus width and height, go
 * on the img.
 */
export interface Props
  extends HTMLAttributes<"figure">,
    ImageElementAttributes,
    VariantProps<typeof image> {
  /** An imported local asset (optimised by Astro) or a remote URL string. */
  src: ImageMetadata | string;
  /** Required. Use an empty string for decorative images. */
  alt: string;
  width?: number;
  height?: number;
  /** Owner of the photo; rendered as "© {credit}". The `credit` slot replaces it. */
  credit?: string;
}

const RESPONSIVE_WIDTHS = [480, 800, 1200, 1600, 2400];

const {
  src,
  alt,
  credit,
  ratio = "auto",
  fit = "cover",
  width,
  height,
  loading,
  decoding,
  fetchpriority,
  sizes,
  class: className,
  ...attributes
} = Astro.props;

const isRemote = typeof src === "string";

if (typeof alt !== "string") {
  throw new Error(`Image '${isRemote ? src : src.src}' requires an alt attribute (use alt="" for decorative images).`);
}

const hasCreditSlot = Astro.slots.has("credit");
const hasCredit = hasCreditSlot || Boolean(credit);

const widths = isRemote
  ? []
  : [...RESPONSIVE_WIDTHS.filter(width => width < src.width), src.width];
---

<figure {...attributes} class:list={[image({ ratio, fit }), className]}>
  {
    isRemote
      ? <img src={src} alt={alt} width={width} height={height} sizes={sizes} loading={loading ?? "lazy"} decoding={decoding ?? "async"} fetchpriority={fetchpriority} />
      : <OptimizedImage src={src} alt={alt} width={width} height={height} widths={widths} sizes={sizes ?? "100vw"} loading={loading} decoding={decoding} fetchpriority={fetchpriority} />
  }
  {
    hasCredit &&
    <figcaption class="image-credit">
      {hasCreditSlot ? <slot name="credit" /> : creditText(credit!)}
    </figcaption>
  }
</figure>

<style>
  .image {
    position: relative;
    width: 100%;
  }

  .image img {
    width: 100%;
    height: auto;
    object-fit: var(--image-fit);
  }

  /*
   * Only a set ratio declares aspect-ratio. Without one, the img keeps the
   * `auto W / H` ratio the browser maps from its width and height attributes,
   * so it holds its height before the file loads; a plain `auto` would leave
   * it 0px tall until then.
   */
  .ratio-1-1 img { aspect-ratio: 1 / 1; }
  .ratio-3-2 img { aspect-ratio: 3 / 2; }
  .ratio-2-3 img { aspect-ratio: 2 / 3; }
  .ratio-4-3 img { aspect-ratio: 4 / 3; }
  .ratio-3-4 img { aspect-ratio: 3 / 4; }
  .ratio-16-9 img { aspect-ratio: 16 / 9; }

  .fit-cover { --image-fit: cover; }
  .fit-contain { --image-fit: contain; }
</style>
