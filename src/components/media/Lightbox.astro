---
import '../../styles/global.css'
import './credit.css'
import type { HTMLAttributes } from "astro/types";
import Icon from '../ui/Icon.astro';
import DialogClose from '../overlay/DialogClose.astro';

/**
 * A full-size photo viewer for Galleries: a modal native `dialog`, with the
 * same close button, light dismiss and focus return as Dialog.
 * Place one on a page that has Galleries: it opens when a Gallery image is
 * clicked (through the `gallery-open` event), shows the full-size image with
 * its credit footer, moves to the previous or next image with its buttons or
 * the arrow keys, and returns focus to the clicked image on close. Escape and
 * a click outside close it.
 * An image whose detail has a `srcset` and `sizes` loads the width the
 * browser picks; one with a `caption` shows it under the photo, below the
 * credit. A caption longer than three lines scrolls, and takes a tab stop
 * so a keyboard can scroll it: Safari does not focus scroll containers, and
 * the left and right arrows belong to the viewer.
 *
 * Without JavaScript, or without a Lightbox, a Gallery image is a plain link
 * to the full-size photo.
 */
export interface Props extends HTMLAttributes<"dialog"> {
  /** The viewer's accessible name. */
  label?: string;
  closeLabel?: string;
  previousLabel?: string;
  nextLabel?: string;
}

const {
  label = "Photo viewer",
  closeLabel = "Close",
  previousLabel = "Previous photo",
  nextLabel = "Next photo",
  class: className,
  ...attributes
} = Astro.props;
---

<light-box>
  <dialog {...attributes} aria-label={label} closedby="any" class:list={["lightbox", className]}>
    <DialogClose label={closeLabel} class="lightbox-control lightbox-close" />
    <figure class="lightbox-figure" data-lightbox-figure></figure>
    <p class="lightbox-counter" aria-live="polite" data-lightbox-counter></p>
    <button type="button" class="lightbox-control lightbox-previous" aria-label={previousLabel} data-lightbox-step="-1"><Icon icon="chrevron-left" aria-hidden="true" /></button>
    <button type="button" class="lightbox-control lightbox-next" aria-label={nextLabel} data-lightbox-step="1"><Icon icon="chrevron-right" aria-hidden="true" /></button>
  </dialog>
</light-box>

<style>
  /*
   * Like the Image credit band (credit.css), the viewer reads against the
   * photo, not the page, so it uses the theme-independent scrim tones.
   */
  .lightbox {
    max-width: 100vw;
    max-height: 100dvh;
    padding: 0;
    overflow: visible;
    border: 0;
    background: none;
    color: hsl(var(--color-on-scrim));
    --lightbox-caption-room: calc(var(--space-xs) + 3 * 1.4 * var(--fs-sm));
  }

  .lightbox::backdrop {
    background-color: hsl(var(--color-scrim) / .9);
  }

  /*
   * A grid as wide as its photo: a caption wraps under the photo instead of
   * widening the viewer, and the credit band, placed in the photo's cell,
   * sits across the photo's bottom edge rather than the caption's.
   */
  .lightbox-figure {
    position: relative;
    display: grid;
    width: min-content;
  }

  /* Explicit end lines: on an absolutely positioned item, `auto` is the grid's padding edge. */
  .lightbox-figure :global(.image-credit) {
    grid-area: 1 / 1 / 2 / 2;
  }

  .lightbox-figure :global(img) {
    width: auto;
    height: auto;
    max-width: calc(100vw - 2 * var(--space-md));
    max-height: calc(100dvh - 2 * var(--space-md));
  }

  /* Up to three lines of caption fit under the photo; a longer one scrolls. */
  .lightbox-figure:has(:global(.lightbox-caption)) :global(img) {
    max-height: calc(100dvh - 2 * var(--space-md) - var(--lightbox-caption-room));
  }

  .lightbox-figure :global(.lightbox-caption) {
    max-height: var(--lightbox-caption-room);
    overflow-y: auto;
    padding-top: var(--space-xs);
    font-size: var(--fs-sm);
    line-height: 1.4;
  }

  .lightbox-figure :global(.lightbox-caption:focus-visible) {
    outline: 2px solid hsl(var(--color-on-scrim));
    outline-offset: 2px;
  }

  .lightbox-control,
  .lightbox-counter {
    position: absolute;
    background-color: hsl(var(--color-scrim) / .6);
    color: inherit;
  }

  .lightbox-control {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    z-index: 1;
  }

  .lightbox-control:hover {
    background-color: hsl(var(--color-scrim) / .85);
  }

  .lightbox-control:focus-visible {
    outline: 2px solid hsl(var(--color-on-scrim));
    outline-offset: 2px;
  }

  .lightbox-control :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .lightbox-close {
    top: 0.75rem;
    right: 0.75rem;
  }

  .lightbox-previous,
  .lightbox-next {
    top: 50%;
    translate: 0 -50%;
  }

  .lightbox-previous { left: 0.75rem; }
  .lightbox-next { right: 0.75rem; }

  .lightbox-control[hidden] {
    display: none;
  }

  .lightbox-counter {
    top: 0.75rem;
    left: 0.75rem;
    z-index: 1;
    padding: 0.25em 0.75em;
    border-radius: 9999px;
    font-size: var(--fs-sm);
  }

  .lightbox-counter:empty {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open],
    .lightbox[open]::backdrop {
      animation: lightbox-in 200ms ease-out;
    }
  }

  @keyframes lightbox-in {
    from { opacity: 0; }
  }

  @media (forced-colors: active) {
    .lightbox-control,
    .lightbox-counter {
      border: 1px solid CanvasText;
    }
  }
</style>

<script>
  import { installLightDismissFallback, returnFocusOnClose } from '../overlay/dialog';
  import { creditText } from './credit';
  import { GALLERY_OPEN_EVENT, type GalleryImageDetail, type GalleryOpenEvent } from './gallery-open';

  class LightBox extends HTMLElement {
    dialog!: HTMLDialogElement;
    images: GalleryImageDetail[] = [];
    index = 0;
    // The caption's width follows the photo's, so it can start or stop overflowing when the photo loads or the viewport resizes.
    captionObserver = new ResizeObserver(entries => entries.forEach(entry => this.fitCaption(entry.target as HTMLElement)));

    connectedCallback() {
      this.dialog = this.querySelector('dialog')!;

      this.dialog.addEventListener('keydown', event => {
        const step = { ArrowLeft: -1, ArrowRight: 1 }[event.key];
        if (step === undefined) return;

        event.preventDefault();
        this.show(this.index + step);
      });

      this.querySelectorAll<HTMLElement>('[data-lightbox-step]').forEach(button => {
        button.addEventListener('click', () => this.show(this.index + Number(button.dataset.lightboxStep)));
      });

      document.addEventListener(GALLERY_OPEN_EVENT, this.onGalleryOpen);
    }

    disconnectedCallback() {
      document.removeEventListener(GALLERY_OPEN_EVENT, this.onGalleryOpen);
      this.captionObserver.disconnect();
    }

    onGalleryOpen = (event: GalleryOpenEvent) => {
      if (event.defaultPrevented) return;
      event.preventDefault();

      const { index, images, trigger } = event.detail;
      this.images = images;

      this.querySelectorAll<HTMLElement>('[data-lightbox-step]').forEach(button => {
        button.hidden = images.length < 2;
      });

      this.show(index);
      this.dialog.showModal();
      returnFocusOnClose(this.dialog, trigger);
    };

    show(index: number) {
      const count = this.images.length;
      this.index = (index + count) % count;

      const { src, srcset, sizes, alt, width, height, credit, caption } = this.images[this.index];
      const image = document.createElement('img');
      if (srcset) image.srcset = srcset;
      if (sizes) image.sizes = sizes;
      image.src = src;
      image.alt = alt;
      if (width && height) {
        image.width = width;
        image.height = height;
      }

      const figure = this.querySelector('[data-lightbox-figure]')!;
      const hadFocus = figure.contains(document.activeElement);
      this.captionObserver.disconnect();
      figure.replaceChildren(image);

      // A figure has one figcaption: the caption when there is one, otherwise the credit.
      if (credit) {
        const band = document.createElement(caption ? 'p' : 'figcaption');
        band.className = 'image-credit';
        band.textContent = creditText(credit);
        figure.append(band);
      }

      if (caption) {
        const captionElement = document.createElement('figcaption');
        captionElement.className = 'lightbox-caption';
        captionElement.textContent = caption;
        captionElement.addEventListener('blur', () => this.fitCaption(captionElement));
        figure.append(captionElement);
        this.captionObserver.observe(captionElement);
      }

      // Stepping from a focused caption keeps focus on the new caption, or else where it starts when the viewer opens.
      if (hadFocus) {
        const captionElement = figure.querySelector<HTMLElement>('.lightbox-caption');
        if (captionElement) captionElement.tabIndex = 0;
        (captionElement ?? this.querySelector<HTMLElement>('.lightbox-close')!).focus();
      }
      this.querySelector('[data-lightbox-counter]')!.textContent = count > 1 ? `${this.index + 1} / ${count}` : '';
    }

    /**
     * Gives a caption a tab stop only while it overflows. A focused caption
     * keeps it until blur, so focus never drops out of the viewer.
     */
    fitCaption(caption: HTMLElement) {
      if (caption === document.activeElement) return;

      if (caption.scrollHeight > caption.clientHeight) caption.tabIndex = 0;
      else caption.removeAttribute('tabindex');
    }
  }

  installLightDismissFallback();
  customElements.define('light-box', LightBox);
</script>
