---
import '../../styles/global.css'
import { cva } from 'cva';
import type { HTMLAttributes } from "astro/types";
import Label from './Label.astro';
import { nextFieldId, wireControl } from './wire-control';

const formField = cva("form-field", {
  variants: {
    kind: {
      field: "stacked",
      check: "inline",
      group: "stacked"
    },
    invalid: {
      true: "invalid"
    }
  }
});

/**
 * Ties a label, a control (default slot), a hint and an error together. It
 * gives the control an id (unless it has one), points the label at it, lists
 * the hint and error in its aria-describedby and sets aria-invalid when there
 * is an error. A Checkbox or Switch sits beside its label; a RadioGroup is
 * named through aria-labelledby.
 */
export interface Props extends HTMLAttributes<"div"> {
  label: string;
  hint?: string;
  /** Error message; when set, the control is marked aria-invalid. */
  error?: string;
}

const { label, hint, error, class: className, ...attributes } = Astro.props;

const base = nextFieldId();
const ids = { control: `${base}-control`, label: `${base}-label`, hint: `${base}-hint`, error: `${base}-error` };

const control = wireControl(await Astro.slots.render("default"), {
  id: ids.control,
  labelId: ids.label,
  describedBy: [hint && ids.hint, error && ids.error].filter((id): id is string => Boolean(id)),
  invalid: Boolean(error)
});

if (!control) {
  throw new Error(`FormField '${label}' needs a form control (Input, Textarea, Select, Checkbox, Switch or RadioGroup) in its default slot.`);
}
---

<div {...attributes} class:list={[formField({ kind: control.kind, invalid: Boolean(error) }), "ff-sans-normal", className]}>
  {
    control.kind === "group"
      ? <span id={ids.label} class="group-label">{label}</span>
      : <Label for={control.id} id={ids.label} class="field-label">{label}</Label>
  }
  <div class="control"><Fragment set:html={control.html} /></div>
  {hint && <p id={ids.hint} class="hint">{hint}</p>}
  {error && <p id={ids.error} class="error">{error}</p>}
</div>

<style>
  .form-field {
    display: grid;
    gap: 0.375rem;
    align-items: center;
    min-width: 0;
  }

  .group-label {
    font-size: var(--fs-sm);
    font-weight: 600;
    line-height: 1.4;
  }

  /* Checkbox and Switch: control first, label beside it, hint and error under the label. */
  .inline {
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.625rem;
  }

  .inline .control {
    grid-row: 1;
    grid-column: 1;
    display: flex;
  }

  .inline :global(.field-label) {
    grid-row: 1;
    grid-column: 2;
    font-weight: 400;
    font-size: var(--fs-md);
    cursor: pointer;
  }

  .inline .hint,
  .inline .error {
    grid-column: 2;
  }

  .hint,
  .error {
    font-size: var(--fs-sm);
    line-height: 1.4;
  }

  .hint {
    color: hsl(var(--color-on-background) / .75);
  }

  .error {
    color: hsl(var(--color-error-text));
    font-weight: 600;
  }

  .invalid :global(.field-label),
  .invalid .group-label {
    color: hsl(var(--color-error-text));
  }
</style>
