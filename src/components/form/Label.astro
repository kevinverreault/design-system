---
import '../../styles/global.css'
import type { HTMLAttributes } from "astro/types";

export interface Props extends HTMLAttributes<"label"> {}

const { class: className, ...attributes } = Astro.props;
---

<label {...attributes} class:list={["label", "ff-sans-normal", className]}>
  <slot />
</label>

<style>
  .label {
    display: inline-block;
    font-size: var(--fs-sm);
    font-weight: 600;
    line-height: 1.4;
    color: hsl(var(--color-on-background));
  }
</style>
